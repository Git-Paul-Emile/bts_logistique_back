# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env n'est jamais commité.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# Application
NODE_ENV=development
APP_NAME="BTS Logistique API"
PORT=4000
LOG_LEVEL=info
# Origines autorisées à appeler l'API (front), séparées par des virgules
CORS_ORIGINS=http://localhost:5173
# URL publique du front, utilisée dans les liens des e-mails
FRONT_URL=http://localhost:5173
# Mettre true quand l'API est derrière un proxy (hébergeur, Nginx), pour lire la vraie IP
TRUST_PROXY=false

# Base de données PostgreSQL
# Connexion utilisée par l'application. Sur Neon : l'URL avec "-pooler" dans l'hôte.
# Sur Neon, remplacer sslmode=require par sslmode=verify-full (même sécurité, sans avertissement
# du pilote pg), dans DATABASE_URL comme dans DIRECT_URL.
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/bts_logistique?schema=public
# Connexion utilisée par la CLI Prisma (migrations). Sur Neon : la même URL sans "-pooler".
# Laisser vide hors Neon : DATABASE_URL est alors utilisée.
DIRECT_URL=

# Authentification (secrets d'au moins 32 caractères, différents l'un de l'autre)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Envoi des e-mails par Resend (clé API créée sur resend.com, secrète).
# Sans RESEND_API_KEY, aucun e-mail ne part : ils attendent dans la boîte d'envoi.
RESEND_API_KEY=
# Obligatoire si RESEND_API_KEY est renseignée. L'adresse doit être sur un domaine vérifié chez
# Resend (enregistrements SPF et DKIM ajoutés au DNS du domaine).
MAIL_FROM="BTS Logistique <no-reply@bts-logistique.com>"
